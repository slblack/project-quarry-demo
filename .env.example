# Copy to .env (never commit .env). Values saved later from the Setup dialog take precedence.
# Scripted scenarios need no keys at all. Live mode needs an OpenAI key.
OPENAI_API_KEY=
AI_DEFENSE_API_KEY=

# Model that drives the live agent (OpenAI Responses API with function calling).
OPENAI_MODEL=gpt-6-luna
# Model used by the AI-judge rule in live mode. Blank = same as OPENAI_MODEL.
JUDGE_MODEL=
# Upper bound on generated tokens per model call (64–4000).
OPENAI_MAX_OUTPUT_TOKENS=2000

# Cisco AI Defense inspection region: us, eu or ap. Must match your tenant.
AI_DEFENSE_REGION=us
AI_DEFENSE_CONNECTION_NAME=
